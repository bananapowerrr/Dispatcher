# ── Секреты и локальное окружение ───────────────────────────────
.env
.env.*
!.env.example
credentials/
projects/

# ── Виртуальные окружения (никогда не в git) ────────────────────
.venv/
.venv-aider/
venv/
env/

# ── Python-кэш и сборка ─────────────────────────────────────────
