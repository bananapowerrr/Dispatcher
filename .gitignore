# ── Секреты и локальное окружение ───────────────────────────────
.env
.env.*
!.env.example
credentials/
projects/

# ── Виртуальные окружения (никогда не в git) ────────────────────
.venv/
.venv-aider/
venv/
env/

# ── Python-кэш и сборка ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# ── Runtime: шина каналов, состояние задач, события ─────────────
channels/
events/
.agentbus/
incoming/
processing/
done/
errors/
deferred/
logs/
# archive/ убран намеренно: в docs/archive лежат отчёты о приёмке,
# они отслеживались в git, а правилоarchive/ им противоречило. Из-за
# этого расхождения скрипт предлагал удалить их из GitHub.
# Служебные папки переименованы, чтобы «мусор» не спорил с документами.
gemini_archive/
GeminiProcessed/

# ── Runtime-состояние в json ────────────────────────────────────
cloud_usage.json
discovered.json
notion_state.json
providers_state.json
rate_limit_until.json
ranker_state.json
workers_state.json

# ── Артефакты тестов и прогона ──────────────────────────────────
.testruns/
junit*.xml
.coverage
coverage.xml
htmlcov/

# ── Логи и временные файлы ──────────────────────────────────────
*.log
*.tmp
*.bak
crash.log
push_agentbus_to_git.ps1

# ── Служебное от синхронизации Drive ↔ GitHub ─────────────────────
# Тестовый файл Apps Script selftest(). Раньше утекал в репозиторий
# и коммитился локальным автопушем.
__sync_selftest__.txt

# ── OS-мусор ────────────────────────────────────────────────────
# ── Мусор операционной системы ─────────────────────────────────
# Создаётся Windows в любой синхронизируемой папке, включая саму Drive.
.DS_Store
desktop.ini
Thumbs.db
Desktop.ini

# ── Вложенные git-worktree агентов (Kilo) ───────────────────────
# Внутри репозитория лежит полная копия проекта в .kilo/worktrees/.
# Раньше она была защищена только локальным .git/info/exclude, которого
# нет в свежем клоне — 710 файлов могли уехать в индекс и в Drive.
.kilo/
.kilocode/
.aider*

# runtime-состояние intelligence, генерируется при работе
lessons.json
solution_cache.json
semantic_memory.json
