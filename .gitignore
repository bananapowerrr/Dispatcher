*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# ── Runtime: шина каналов, состояние задач, события ─────────────
channels/
events/
.agentbus/
incoming/
processing/
done/
errors/
deferred/
logs/
archive/
gemini_archive/
GeminiProcessed/

# ── Runtime-состояние в json ────────────────────────────────────
cloud_usage.json
discovered.json
notion_state.json
providers_state.json
rate_limit_until.json
ranker_state.json
workers_state.json

# ── Артефакты тестов и прогона ──────────────────────────────────
.testruns/
junit*.xml
.coverage
coverage.xml
htmlcov/

# ── Логи и временные файлы ──────────────────────────────────────
*.log
*.tmp
*.bak
crash.log
push_agentbus_to_git.ps1

# ── OS-мусор ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
